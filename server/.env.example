# 服务端口
PORT=4000

# JWT 密钥（生产环境务必使用足够长的随机字符串）
JWT_SECRET=please_change_me_in_production_use_long_random_string

# JWT 过期时间，例如 7d、24h
JWT_EXPIRES_IN=7d

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=peakmix
DB_PASSWORD=your_password
DB_NAME=peakmix

# 文件存储根目录（上传临时文件、输出 mp3/xlsx）
STORAGE_ROOT=./data

# ffmpeg 可执行文件（Linux 一般 /usr/bin/ffmpeg；Windows 可写完整路径）
FFMPEG_PATH=ffmpeg
